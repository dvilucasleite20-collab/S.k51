local FogBackup = nil
local NoFogConnection = nil
local NoFogAtmosphereBackup = setmetatable({}, {__mode = "k"})

local function ApplyNoFogNow()
    if not Config.NoFog then
        return
    end

    Lighting.FogStart = 0
    Lighting.FogEnd = 1000000

    for _, obj in ipairs(Lighting:GetChildren()) do
        if obj:IsA("Atmosphere") then
            if not NoFogAtmosphereBackup[obj] then
                NoFogAtmosphereBackup[obj] = {
                    Density = obj.Density,
                    Haze = obj.Haze,
                    Glare = obj.Glare,
                }
            end

            obj.Density = 0
            obj.Haze = 0
            obj.Glare = 0
        end
    end
end

F.applyNoFog = function()
    if Config.NoFog then
        if not FogBackup then
            FogBackup = {
                FogStart = Lighting.FogStart,
                FogEnd = Lighting.FogEnd,
                FogColor = Lighting.FogColor
            }
        end

        ApplyNoFogNow()

        if not NoFogConnection then
            NoFogConnection = RunService.RenderStepped:Connect(function()
                if Config.NoFog then
                    ApplyNoFogNow()
                end
            end)
        end
    else
        if NoFogConnection then
            NoFogConnection:Disconnect()
            NoFogConnection = nil
        end

        for atmosphere, backup in pairs(NoFogAtmosphereBackup) do
            if atmosphere and atmosphere.Parent and backup then
                atmosphere.Density = backup.Density
                atmosphere.Haze = backup.Haze
                atmosphere.Glare = backup.Glare
            end
            NoFogAtmosphereBackup[atmosphere] = nil
        end

        if FogBackup then
            Lighting.FogStart = FogBackup.FogStart
            Lighting.FogEnd = FogBackup.FogEnd
            Lighting.FogColor = FogBackup.FogColor
            FogBackup = nil
        end
    end
end

