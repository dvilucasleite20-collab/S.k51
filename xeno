--==================================================
-- NO KILLERS
-- Remove somente a colisao entre cada Killer e a Part que ele esta pisando.
-- O jogador local continua colidindo normalmente com a mesma Part.
-- MapLimit/Maplimit e sempre ignorado.
--==================================================

local NO_KILLERS_PLACES = {
    [3182083477] = true,
    [3508248007] = true,
    [5740483929] = true,
    [2675280735] = true,
    [2092166489] = true,
}

local NoKillersConnections = {}
local NoKillersFloorByKiller = setmetatable({}, {__mode = "k"})
local NoKillersConstraints = setmetatable({}, {__mode = "k"})
local NoKillersPartCount = setmetatable({}, {__mode = "k"})
local NoKillersLastScan = 0
local NO_KILLERS_SCAN_INTERVAL = 0.12

local function NoKillersPlaceAllowed()
    return NO_KILLERS_PLACES[game.PlaceId] == true
end

local function NoKillersGetRoot(killer)
    if not killer or not killer.Parent then
        return nil
    end

    return FindFirstChild(killer, "HumanoidRootPart")
        or FindFirstChild(killer, "Torso")
        or killer:FindFirstChildWhichIsA("BasePart", true)
end

local function NoKillersIsMapLimitPart(part)
    if not part then
        return false
    end

    local obj = part
    while obj and obj ~= Workspace do
        if obj.Name == "MapLimit" or obj.Name == "Maplimit" then
            return true
        end
        obj = obj.Parent
    end

    return false
end

local function NoKillersGetFloor(killer, root)
    if not root then
        return nil
    end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {killer}
    params.IgnoreWater = true

    -- O raycast parte um pouco acima do RootPart para evitar pegar o proprio Killer.
    local result = Workspace:Raycast(
        root.Position + Vector3.new(0, 0.75, 0),
        Vector3.new(0, -12, 0),
        params
    )

    local part = result and result.Instance
    if not part or not part:IsA("BasePart") then
        return nil
    end

    -- Se a Part pertence ao modelo MapLimit/Maplimit, nunca mexe nela.
    if part:IsDescendantOf(killer) or NoKillersIsMapLimitPart(part) then
        return nil
    end

    -- Somente superficies com orientacao de chao.
    if result.Normal and result.Normal.Y < 0.5 then
        return nil
    end

    return part
end

local function NoKillersDestroyConstraints(killer)
    local constraints = NoKillersConstraints[killer]
    if not constraints then
        return
    end

    for i = 1, #constraints do
        local constraint = constraints[i]
        if constraint then
            pcall(function()
                constraint:Destroy()
            end)
        end
    end

    NoKillersConstraints[killer] = nil
    NoKillersPartCount[killer] = nil
end

local function NoKillersClearKiller(killer)
    NoKillersFloorByKiller[killer] = nil
    NoKillersDestroyConstraints(killer)
end

local function NoKillersApplyToKiller(killer, floor)
    if not killer or not killer.Parent then
        return
    end

    if not floor or not floor.Parent or NoKillersIsMapLimitPart(floor) then
        NoKillersClearKiller(killer)
        return
    end

    local currentFloor = NoKillersFloorByKiller[killer]

    local parts = {}
    local partCount = 0

    for _, part in ipairs(killer:GetDescendants()) do
        if part:IsA("BasePart") then
            partCount += 1
            parts[part] = true
        end
    end

    -- Nada mudou: nao recria centenas de constraints desnecessariamente.
    if currentFloor == floor
        and NoKillersConstraints[killer]
        and NoKillersPartCount[killer] == partCount then
        return
    end

    NoKillersClearKiller(killer)

    local constraints = {}

    -- NoCollisionConstraint e usado somente entre o Killer e a Part do piso.
    -- Isso deixa a mesma Part normalmente colidivel para o jogador local.
    for part in pairs(parts) do
        local constraint = InstanceNew("NoCollisionConstraint")
        constraint.Part0 = part
        constraint.Part1 = floor
        constraint.Parent = part
        constraints[#constraints + 1] = constraint
    end

    if #constraints == 0 then
        return
    end

    NoKillersFloorByKiller[killer] = floor
    NoKillersConstraints[killer] = constraints
    NoKillersPartCount[killer] = partCount
end

local function NoKillersScan()
    if not Config.NoKillers or not NoKillersPlaceAllowed() then
        return
    end

    local now = os.clock()
    if now - NoKillersLastScan < NO_KILLERS_SCAN_INTERVAL then
        return
    end
    NoKillersLastScan = now

    local active = {}

    for _, killer in ipairs(Killers:GetChildren()) do
        if killer:IsA("Model") then
            local root = NoKillersGetRoot(killer)
            if root then
                active[killer] = true
                NoKillersApplyToKiller(killer, NoKillersGetFloor(killer, root))
            end
        end
    end

    for killer in pairs(NoKillersFloorByKiller) do
        if not active[killer] or not killer.Parent then
            NoKillersClearKiller(killer)
        end
    end
end

local function NoKillersStop()
    if NoKillersConnections.Heartbeat then
        NoKillersConnections.Heartbeat:Disconnect()
        NoKillersConnections.Heartbeat = nil
    end

    if NoKillersConnections.ChildAdded then
        NoKillersConnections.ChildAdded:Disconnect()
        NoKillersConnections.ChildAdded = nil
    end

    for killer in pairs(NoKillersFloorByKiller) do
        NoKillersClearKiller(killer)
    end

    -- Limpa qualquer estado residual.
    for killer in pairs(NoKillersConstraints) do
        NoKillersClearKiller(killer)
    end
end

local function NoKillersStart()
    NoKillersStop()
    NoKillersLastScan = 0

    NoKillersConnections.Heartbeat = RunService.Heartbeat:Connect(NoKillersScan)
    NoKillersConnections.ChildAdded = Killers.ChildAdded:Connect(function(killer)
        if not Config.NoKillers or not killer or not killer:IsA("Model") then
            return
        end

        task.defer(function()
            if Config.NoKillers and killer.Parent == Killers then
                pcall(NoKillersScan)
            end
        end)
    end)

    NoKillersScan()
end

