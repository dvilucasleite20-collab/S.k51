F.SuperBulletRelease = function(bullet, data)
    if not bullet or not bullet.Parent or not data then
        return
    end

    local killer, target = F.SuperBulletGetNearestKiller(bullet.Position)

    if not killer or not target then
        data.WaitingForTarget = true
        data.Frozen = true
        return
    end

    if F.GetForceField(killer) then
        data.WaitingForForceField = true
        data.Frozen = true
        return
    end

    data.Frozen = false
    data.WaitingForTarget = false
    data.WaitingForForceField = false
    data.Killer = killer
    data.Part = target
    data.LastPosition = target.Position

    pcall(function()
        bullet.Anchored = false
        bullet.CFrame = CFrame.new(target.Position)
    end)
end

F.SuperBulletTrack = function(bullet)
    if not Config.SuperBullet
        or not F.SuperBulletIsMyBullet(bullet)
        or superBulletTracked[bullet] then
        return
    end

    local now = os.clock()
    superBulletTracked[bullet] = {
        Frozen = true,
        StartedAt = now,
        ReleaseAt = now + math.clamp(
            tonumber(Config.SuperBulletTime) or 5,
            SUPER_BULLET_MIN_TIME,
            SUPER_BULLET_MAX_TIME
        ),
        CFrame = bullet.CFrame,
        Killer = nil,
        Part = nil,
        LastPosition = bullet.Position,
        WaitingForTarget = false,
        WaitingForForceField = false
    }

    pcall(function()
        bullet.Anchored = true
        bullet.AssemblyLinearVelocity = Vector3.zero
        bullet.AssemblyAngularVelocity = Vector3.zero
    end)
end

