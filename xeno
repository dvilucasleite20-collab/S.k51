-- TELEPORT
-- ============================================================

local ProtectPlayer = {
    SelectedPlayer = nil,
    Enabled = false,
    Dropdown = nil,
    Heartbeat = nil,
    CharacterAdded = nil
}

function ProtectPlayer.GetTarget()
    local p = ProtectPlayer.SelectedPlayer and Players:FindFirstChild(ProtectPlayer.SelectedPlayer)
    local c = p and p.Character
    local f = Workspace:FindFirstChild("Characters to kill")
    local r = c and F.TeleportGetRoot(c)
    if not p or not c or not f or not c:IsDescendantOf(f) or not r or not F.KillAllIsAlive(c) then return end
    return p, c, r
end

function ProtectPlayer.GetNearestKiller(pos)
    if not pos then return end
    local nearest, best = nil, math.huge
    for _, k in ipairs(Killers:GetChildren()) do
        if k:IsA("Model") and F.KillAllIsAlive(k) then
            local r = F.TeleportGetRoot(k)
            if r then
                local d = (r.Position - pos).Magnitude
                if d < best then best, nearest = d, k end
            end
        end
    end
    return nearest
end

function ProtectPlayer.Refresh()
    if not ProtectPlayer.Dropdown then return end
    pcall(function()
        local options = F.TeleportGetPlayerOptions()
        local selected = ProtectPlayer.SelectedPlayer
        local valid = false
        if selected then
            for _, n in ipairs(options) do
                if n == selected then valid = true break end
            end
        end
        if not valid then ProtectPlayer.SelectedPlayer = nil end
        ProtectPlayer.Dropdown:Refresh(options, false)
    end)
end

function ProtectPlayer.Update()
    if not ProtectPlayer.Enabled then return end
    local _, _, tr = ProtectPlayer.GetTarget()
    if not tr then return end
    local c = LocalPlayer.Character
    local myRoot = c and F.TeleportGetRoot(c)
    if not c or not myRoot then return end

    local k = ProtectPlayer.GetNearestKiller(tr.Position)
    local kr = k and F.TeleportGetRoot(k)
    if not kr then return end

    local offset = kr.Position - tr.Position
    local flat = Vector3.new(offset.X, 0, offset.Z)
    if flat.Magnitude < 0.001 then return end

    local orbitPosition = tr.Position + flat.Unit * 2.5
    orbitPosition = Vector3.new(orbitPosition.X, myRoot.Position.Y, orbitPosition.Z)
    local lookDirection = flat.Unit

    pcall(function()
        c:PivotTo(CFrame.lookAt(orbitPosition, orbitPosition + lookDirection))
    end)
end

function ProtectPlayer.Stop()
    if ProtectPlayer.Heartbeat then ProtectPlayer.Heartbeat:Disconnect(); ProtectPlayer.Heartbeat = nil end
    if ProtectPlayer.CharacterAdded then ProtectPlayer.CharacterAdded:Disconnect(); ProtectPlayer.CharacterAdded = nil end
end

function ProtectPlayer.Start()
    ProtectPlayer.Stop()
    ProtectPlayer.Heartbeat = RunService.Heartbeat:Connect(ProtectPlayer.Update)
    ProtectPlayer.CharacterAdded = LocalPlayer.CharacterAdded:Connect(function()
        if ProtectPlayer.Enabled then task.defer(ProtectPlayer.Update) end
    end)
    task.defer(ProtectPlayer.Update)
end


local SelectedTeleportKiller = nil
local SelectedTeleportPlayer = nil
local teleportKillerDropdown
local teleportPlayerDropdown
local teleportKillerListKey = ""
local teleportPlayerListKey = ""
local updatingTeleportKillerDropdown = false
local updatingTeleportPlayerDropdown = false

F.TeleportGetRoot = function(character)
    if not character then return nil end
    return character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Torso")
end

F.TeleportGetAliveKillerOptions = function()
    local options, seen = {}, {}
    for _, killer in ipairs(Killers:GetChildren()) do
        if killer:IsA("Model") and not seen[killer.Name] then
            local hum = killer:FindFirstChildOfClass("Humanoid") or killer:FindFirstChild("Humanoid", true)
            if hum and hum.Health > 0 and F.TeleportGetRoot(killer) then
                seen[killer.Name] = true
                options[#options + 1] = killer.Name
            end
        end
    end
    table.sort(options, function(a,b) return string.lower(a) < string.lower(b) end)
    return options
end

F.TeleportGetPlayerOptions = function()
    local options, seen = {}, {}
    local folder = Workspace:FindFirstChild("Characters to kill")
    if not folder then return options end
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = player.Character
            if char and char:IsDescendantOf(folder) and F.KillAllIsAlive(char) and F.TeleportGetRoot(char) and not seen[player.Name] then
                seen[player.Name] = true
                options[#options + 1] = player.Name
            end
        end
    end
    table.sort(options, function(a,b) return string.lower(a) < string.lower(b) end)
    return options
end

F.TeleportRefreshKillerDropdown = function()
    if updatingTeleportKillerDropdown or not teleportKillerDropdown then return end
    updatingTeleportKillerDropdown = true
    pcall(function()
        local options = F.TeleportGetAliveKillerOptions()
        local key = table.concat(options, "\31")
        if key ~= teleportKillerListKey then
            teleportKillerListKey = key
            local valid = false
            if SelectedTeleportKiller then
                for _, name in ipairs(options) do if name == SelectedTeleportKiller then valid = true break end end
            end
            if not valid then SelectedTeleportKiller = nil end
            teleportKillerDropdown:Refresh(options, false)
        end
    end)
    updatingTeleportKillerDropdown = false
end

F.TeleportRefreshPlayerDropdown = function()
    if updatingTeleportPlayerDropdown or not teleportPlayerDropdown then return end
    updatingTeleportPlayerDropdown = true
    pcall(function()
        local options = F.TeleportGetPlayerOptions()
        local key = table.concat(options, "\31")
        if key ~= teleportPlayerListKey then
            teleportPlayerListKey = key
            local valid = false
            if SelectedTeleportPlayer then
                for _, name in ipairs(options) do if name == SelectedTeleportPlayer then valid = true break end end
            end
            if not valid then SelectedTeleportPlayer = nil end
            teleportPlayerDropdown:Refresh(options, false)
        end
    end)
    updatingTeleportPlayerDropdown = false
end

F.TeleportBehindTarget = function(target)
    local character = LocalPlayer.Character
    local root = F.TeleportGetRoot(target)
    if not character or not root then return end
    pcall(function()
        character:PivotTo(root.CFrame * CFrame.new(0, 0, 1))
    end)
end

