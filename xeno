        F.SuperBulletTrack(obj)
    end)
end)

Workspace.DescendantRemoving:Connect(function(obj)
    superBulletTracked[obj] = nil
end)

RunService.Heartbeat:Connect(function()
    for bullet, data in pairs(superBulletTracked) do
        if not bullet or not bullet.Parent then
            superBulletTracked[bullet] = nil
            continue
        end

        if not Config.SuperBullet then
            F.SuperBulletRelease(bullet, data)
            if not data.Frozen then
                superBulletTracked[bullet] = nil
            end
            continue
        end

        if data.Frozen then
            pcall(function()
                bullet.Anchored = true
                bullet.CFrame = data.CFrame
                bullet.AssemblyLinearVelocity = Vector3.zero
                bullet.AssemblyAngularVelocity = Vector3.zero
            end)

            if os.clock() >= data.ReleaseAt then
                F.SuperBulletRelease(bullet, data)
            end

            continue
        end

        local killer = data.Killer
        local target = data.Part

        if not killer
            or not killer.Parent
            or not target
            or not target.Parent then

            local newKiller, newTarget =
                F.SuperBulletGetNearestKiller(bullet.Position)

            if not newKiller or not newTarget then
                data.Frozen = true
                data.WaitingForTarget = true
                pcall(function()
                    bullet.Anchored = true
                    bullet.CFrame = bullet.CFrame
                    bullet.AssemblyLinearVelocity = Vector3.zero
                    bullet.AssemblyAngularVelocity = Vector3.zero
                end)
                continue
            end

            killer = newKiller
            target = newTarget
            data.Killer = killer
            data.Part = target
            data.LastPosition = target.Position
        end

        if F.GetForceField(killer) then
            data.Frozen = true
            data.WaitingForForceField = true
            data.WaitingForTarget = false
            data.CFrame = bullet.CFrame
            pcall(function()
                bullet.Anchored = true
                bullet.AssemblyLinearVelocity = Vector3.zero
                bullet.AssemblyAngularVelocity = Vector3.zero
            end)
            continue
        end

        if data.WaitingForForceField then
            data.Frozen = false
            data.WaitingForForceField = false
            pcall(function()
                bullet.Anchored = false
                bullet.CFrame = CFrame.new(target.Position)
            end)
        end

        local currentPosition = target.Position
        local movedDistance = (currentPosition - data.LastPosition).Magnitude
        data.LastPosition = currentPosition

        if movedDistance > 0.03 then
            pcall(function()
                bullet.CFrame = CFrame.new(currentPosition)
            end)
        end
    end
end)

