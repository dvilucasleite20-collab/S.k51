F.StopAutoReset = function()
    if F.AutoResetState.Connection then
        F.AutoResetState.Connection:Disconnect()
        F.AutoResetState.Connection = nil
    end
    if F.AutoResetState.CharacterConnection then
        F.AutoResetState.CharacterConnection:Disconnect()
        F.AutoResetState.CharacterConnection = nil
    end
    F.AutoResetState.LastCharacter = nil
end

F.ResetCurrentCharacterIfNeeded = function()
    if not Config.AutoResetWhenKiller and not Config.AutoResetWhenSurvivor then
        return
    end

    local character = LocalPlayer.Character
    if not character or character ~= F.AutoResetState.LastCharacter then
        return
    end

    local isKiller = F.IsLocalPlayerKiller()
    local shouldReset = (Config.AutoResetWhenKiller and isKiller)
        or (Config.AutoResetWhenSurvivor and not isKiller)

    if not shouldReset then
        return
    end

    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if humanoid and humanoid.Health > 0 then
        pcall(function()
            humanoid.Health = 0
        end)
    end
end

F.StartAutoReset = function()
    F.StopAutoReset()
    if not Config.AutoResetWhenKiller and not Config.AutoResetWhenSurvivor then
        return
    end

    local function handleCharacter(character)
        F.AutoResetState.LastCharacter = character

        task.spawn(function()
            task.wait(0.15)
            if character ~= LocalPlayer.Character then
                return
            end
            F.ResetCurrentCharacterIfNeeded()
        end)
    end

    if LocalPlayer.Character then
        F.AutoResetState.LastCharacter = LocalPlayer.Character
    end

    F.AutoResetState.CharacterConnection = LocalPlayer.CharacterAdded:Connect(handleCharacter)

    F.AutoResetState.Connection = RunService.Heartbeat:Connect(function()
        if not LocalPlayer.Character then
            F.AutoResetState.LastCharacter = nil
            return
        end

        if LocalPlayer.Character ~= F.AutoResetState.LastCharacter then
            F.AutoResetState.LastCharacter = LocalPlayer.Character
        end

        F.ResetCurrentCharacterIfNeeded()
    end)
end



