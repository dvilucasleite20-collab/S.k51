local function GunKillAuraUpdateAberrationBlocker()
    local area51 = Workspace:FindFirstChild("AREA51")
    local map = area51 and area51:FindFirstChild("Map")
    local aberration = map and map:FindFirstChild("Aberration")
    local boss = map and map:FindFirstChild("Boss")
    local humanoid = boss and boss:FindFirstChildOfClass("Humanoid")

    if not aberration or not boss or not humanoid then
        return
    end

    local forceField = boss:FindFirstChild("ForceField")

    if humanoid.Health < 5 then
        if forceField then
            GunKillAuraSetAberrationBlockerDeleted(true)
        else
            GunKillAuraSetAberrationBlockerDeleted(false)
        end
    elseif not gunKillAuraAberrationBlockerDeleted then
        -- Aberration: Blocker fica removido enquanto a luta ainda nao chegou
        -- ao estado de restauracao.
        GunKillAuraSetAberrationBlockerDeleted(true)
    end
end

F.GunKillAuraGetBossTarget = function()
    if game.PlaceId ~= 4678052190 and game.PlaceId ~= 6054929905 then
        return nil, nil, nil
    end

    local area51 = Workspace:FindFirstChild("AREA51")
    local map = area51 and area51:FindFirstChild("Map")
    local boss = map and map:FindFirstChild("Boss")
    if not map or not boss then
        return nil, nil, nil
    end

    -- Kraken e Aberration nunca sao tratados ao mesmo tempo.
    -- Detectamos o boss pelo alvo que realmente existe dentro de Boss,
    -- evitando depender da ordem de carregamento dos modelos no Map.
    local weakPoint = boss:FindFirstChild("WeakPoint", true)
    if weakPoint and weakPoint:IsA("BasePart") then
        if not gunKillAuraKrakenMovedWeakPoints[weakPoint] then
            pcall(function()
                weakPoint.CFrame = weakPoint.CFrame + Vector3.new(0, 5, 0)
                gunKillAuraKrakenMovedWeakPoints[weakPoint] = true
            end)
        end

        return nil, weakPoint, "Boss", false
    end

    local aberration = map:FindFirstChild("Aberration")
    local torso = boss:FindFirstChild("Torso", true)
    if aberration and torso and torso:IsA("BasePart") then
        GunKillAuraUpdateAberrationBlocker()
        return nil, torso, "Boss", true
    end

    return nil, nil, nil
end

F.GunKillAuraAcquireTarget = function(bullet)
    local killer, target = F.GunKillAuraGetRandomKiller()

    if killer and target then
        return {
            Mode = "Killer",
            Killer = killer,
            Part = target,
            LastPosition = target.Position,
            Waiting = F.GetForceField(killer) ~= nil
        }
    end

    if game.PlaceId == 4631179692 then
        local targetModel, middle, mode = F.GunKillAuraGetKillhouseTarget(bullet.Position)
        if targetModel and middle then
            return {
                Mode = mode,
                TargetModel = targetModel,
                Part = middle,
                LastPosition = middle.Position,
                Waiting = false
            }
        end
    elseif game.PlaceId == 4678052190 or game.PlaceId == 6054929905 then
        local _, bossTarget, mode, isAberration = F.GunKillAuraGetBossTarget()
        if bossTarget then
            local area51 = Workspace:FindFirstChild("AREA51")
            local map = area51 and area51:FindFirstChild("Map")
            local boss = map and map:FindFirstChild("Boss")

            return {
                Mode = mode,
                Part = bossTarget,
                Boss = boss,
                IsAberration = isAberration == true,
                LastPosition = bossTarget.Position,
                Waiting = boss and F.GetForceField(boss) ~= nil or false
            }
        end
    end

    return {
        Mode = "Pending",
        LastCheck = 0,
        LastPosition = bullet.Position,
        Waiting = false
    }
end

F.GunKillAuraTeleport = function(bullet, data)
    if not bullet or not bullet.Parent or not data or not data.Part then
        return false
    end

    if data.Mode == "Killer" then
        if not data.Killer or not data.Killer.Parent then
            return false
        end

        if F.GetForceField(data.Killer) then
            data.Waiting = true
            return false
        end
    elseif data.Mode == "Boss" then
        local boss = data.Boss
        if boss and F.GetForceField(boss) then
            data.Waiting = true
            return false
        end
    end

    local target = data.Part
    if not target.Parent then
        return false
    end

    data.Waiting = false
    local targetPosition = target.Position

    -- Preserva a rotacao original do projetil. Isso e importante para
    -- flechas, que podem ficar presas na parede e ter a orientacao alterada
    -- pelo sistema da arma. O Gun Kill Aura move apenas a posicao.
    local bulletRotation = data.BulletRotation
    if not bulletRotation then
        bulletRotation = bullet.CFrame - bullet.Position
        data.BulletRotation = bulletRotation
    end

    -- No Kraken, deixa a bala 5 studs acima do WeakPoint para evitar
    -- que ela nasca parcialmente dentro da geometria do alvo.
    if (game.PlaceId == 4678052190 or game.PlaceId == 6054929905)
        and data.Mode == "Boss"
        and not data.IsAberration then
        targetPosition += Vector3.new(0, 5, 0)
    end

    data.LastPosition = targetPosition

    pcall(function()
        bullet.CFrame = CFrame.new(targetPosition) * bulletRotation
    end)

    return true
end

F.GunKillAuraProcessBullet = function(bullet)
    if not Config.GunKillAura then
        return
    end

    if not bullet or not bullet.Parent then
        return
    end

    if gunKillAuraTrackedBullets[bullet] then
        return
    end

    if not F.GunKillAuraIsMyBullet(bullet) then
        return
    end

    gunKillAuraTrackedBullets[bullet] = true
    local acquiredData = F.GunKillAuraAcquireTarget(bullet)
    if acquiredData then
        acquiredData.BulletRotation = bullet.CFrame - bullet.Position
    end
    gunKillAuraChaseTargets[bullet] = acquiredData

    local data = gunKillAuraChaseTargets[bullet]
    if data and data.Mode ~= "Pending" then
        F.GunKillAuraTeleport(bullet, data)
    end
end

