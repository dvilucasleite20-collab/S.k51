--============================================================
-- FOLLOW POWERUPS TO PLAYER
-- Somente na PlaceId 2675280735.
-- Procura Powerup.Hitbox e move SOMENTE a Hitbox para o jogador.
--============================================================

local TELEPORT_POWERUPS_PLACE = 2675280735
local TeleportPowerupsConnection = nil
local TeleportPowerupsDescendantConnection = nil
local TeleportPowerupsTracked = setmetatable({}, {__mode = "k"})

local TeleportPowerupNames = {
    ["nuke"] = true,
    ["maxammo"] = true,
    ["instakill"] = true,
    ["firesale"] = true,
    ["doublepoints"] = true,
    ["carpenter"] = true,
}

local function TeleportPowerupNormalizeName(name)
    return string.lower(tostring(name or "")):gsub("%s+", "")
end

local function TeleportPowerupIsValidModel(obj)
    return obj
        and obj:IsA("Model")
        and TeleportPowerupNames[TeleportPowerupNormalizeName(obj.Name)] == true
end

local function TeleportPowerupGetHitbox(powerup)
    if not TeleportPowerupIsValidModel(powerup) then
        return nil
    end

    local hitbox = powerup:FindFirstChild("Hitbox", true)
    if hitbox and hitbox:IsA("BasePart") then
        return hitbox
    end

    return nil
end

local function TeleportPowerupMoveToPlayer(powerup, characterPivot)
    local hitbox = TeleportPowerupGetHitbox(powerup)
    if not hitbox or not hitbox.Parent then
        return false
    end

    return pcall(function()
        hitbox.CFrame = characterPivot
    end)
end

local function TeleportPowerupProcess(obj)
    if not TeleportPowerupIsValidModel(obj) then
        return
    end

    TeleportPowerupsTracked[obj] = true

    local character = LocalPlayer.Character
    if character and character.Parent then
        local root = character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Torso")
        if root then
            TeleportPowerupMoveToPlayer(obj, root.CFrame)
        end
    end
end

local function TeleportPowerupsStop()
    if TeleportPowerupsConnection then
        TeleportPowerupsConnection:Disconnect()
        TeleportPowerupsConnection = nil
    end

    if TeleportPowerupsDescendantConnection then
        TeleportPowerupsDescendantConnection:Disconnect()
        TeleportPowerupsDescendantConnection = nil
    end

    table.clear(TeleportPowerupsTracked)
end

local function TeleportPowerupsStart()
    TeleportPowerupsStop()

    if game.PlaceId ~= TELEPORT_POWERUPS_PLACE then
        return
    end

    -- Detecta os powerups que ja existem.
    for _, obj in ipairs(Workspace:GetDescendants()) do
        TeleportPowerupProcess(obj)
    end

    -- Detecta somente objetos novos.
    TeleportPowerupsDescendantConnection = Workspace.DescendantAdded:Connect(function(obj)
        if not Config.TeleportPowerupsToPlayer then
            return
        end

        -- O Model pode ser adicionado antes dos filhos; tenta processar quando
        -- o proprio Model aparecer e novamente quando um Hitbox aparecer.
        if TeleportPowerupIsValidModel(obj) then
            task.defer(TeleportPowerupProcess, obj)
        elseif obj:IsA("BasePart") and obj.Name == "Hitbox" then
            local parentModel = obj:FindFirstAncestorOfClass("Model")
            if parentModel and TeleportPowerupIsValidModel(parentModel) then
                task.defer(TeleportPowerupProcess, parentModel)
            end
        end
    end)

    -- Mantem SOMENTE a Hitbox seguindo o jogador.
    TeleportPowerupsConnection = RunService.Heartbeat:Connect(function()
        if not Config.TeleportPowerupsToPlayer or game.PlaceId ~= TELEPORT_POWERUPS_PLACE then
            return
        end

        local character = LocalPlayer.Character
        if not character or not character.Parent then
            return
        end

        local root = character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Torso")
        if not root then
            return
        end

        local rootCFrame = root.CFrame

        for powerup in pairs(TeleportPowerupsTracked) do
            if powerup and powerup.Parent and TeleportPowerupIsValidModel(powerup) then
                TeleportPowerupMoveToPlayer(powerup, rootCFrame)
            else
                TeleportPowerupsTracked[powerup] = nil
            end
        end
    end)
end

