        return
    end

    GunKillAuraUpdateAberrationBlocker()
    GunKillAuraRemoveAberrationSticks()

    for bullet, data in pairs(gunKillAuraChaseTargets) do
        if not bullet or not bullet.Parent then
            gunKillAuraChaseTargets[bullet] = nil
            continue
        end

        if not data then
            gunKillAuraChaseTargets[bullet] = nil
            continue
        end

        local now = os.clock()
        if data.Mode == "Pending" then
            if now < (data.LastCheck or 0) then
                continue
            end

            data.LastCheck = now + GUN_KILL_AURA_REACQUIRE_INTERVAL
            local newData = F.GunKillAuraAcquireTarget(bullet)
            if newData and newData.Mode ~= "Pending" then
                gunKillAuraChaseTargets[bullet] = newData
                F.GunKillAuraTeleport(bullet, newData)
            end
            continue
        end

        local target = data.Part
        if not target or not target.Parent then
            local newData = F.GunKillAuraAcquireTarget(bullet)
            if newData and newData.Mode ~= "Pending" then
                gunKillAuraChaseTargets[bullet] = newData
                F.GunKillAuraTeleport(bullet, newData)
            else
                data.Mode = "Pending"
                data.LastCheck = now
            end
            continue
        end

        if data.Mode == "Killer" then
            local killer = data.Killer
            local humanoid = killer
                and (killer:FindFirstChildOfClass("Humanoid")
                    or killer:FindFirstChild("Humanoid", true))

            if not killer
                or not killer.Parent
                or not humanoid
                or humanoid.Health <= 0 then

                local newData = F.GunKillAuraAcquireTarget(bullet)
                if newData and newData.Mode ~= "Pending" then
                    gunKillAuraChaseTargets[bullet] = newData
                    F.GunKillAuraTeleport(bullet, newData)
                else
                    data.Mode = "Pending"
                    data.LastCheck = now
                end
                continue
            end

            if F.GetForceField(killer) then
                data.Waiting = true
                continue
            end

            if F.GunKillAuraTeleport(bullet, data) then
                data.LastPosition = data.Part.Position
            end
            continue
        end

        if data.Mode == "Boss" then
            local boss = data.Boss
            if not boss or not boss.Parent then
                local _, bossTarget, _, isAberration = F.GunKillAuraGetBossTarget()
                if bossTarget then
                    local area51 = Workspace:FindFirstChild("AREA51")
                    local map = area51 and area51:FindFirstChild("Map")
                    boss = map and map:FindFirstChild("Boss")
                    data.Boss = boss
                    data.Part = bossTarget
                    data.IsAberration = isAberration == true
                else
                    data.Mode = "Pending"
                    data.LastCheck = now
                    continue
                end
            end

            if F.GetForceField(boss) then
                data.Waiting = true
                continue
            end

            if F.GunKillAuraTeleport(bullet, data) then
                data.LastPosition = data.Part.Position
            end
            continue
        end

        if data.Mode == "Killhouse" then
            local targetModel = data.TargetModel
            local enemy = targetModel
                and targetModel:FindFirstChild("Enemy", true)
            local middle = targetModel
                and targetModel:FindFirstChild("Middle", true)

            if not targetModel
                or not targetModel.Parent
                or not enemy
                or not enemy:IsA("Humanoid")
                or enemy.Health ~= 100
                or not middle
                or not middle:IsA("BasePart") then

                local newTargetModel, newMiddle =
                    F.GunKillAuraGetKillhouseTarget(bullet.Position)

                if newTargetModel and newMiddle then
                    data.TargetModel = newTargetModel
                    data.Part = newMiddle
                else
                    data.Mode = "Pending"
                    data.LastCheck = now
                    continue
                end
            else
                data.Part = middle
            end

            if F.GunKillAuraTeleport(bullet, data) then
                data.LastPosition = data.Part.Position
            end
            continue
        end

        if data.Part then
            local currentPosition = data.Part.Position
            local movedDistance = (currentPosition - data.LastPosition).Magnitude

            data.LastPosition = currentPosition
            if movedDistance > 0.03 then
                local bulletRotation = data.BulletRotation
                if not bulletRotation then
                    bulletRotation = bullet.CFrame - bullet.Position
                    data.BulletRotation = bulletRotation
                end
                pcall(function()
                    bullet.CFrame = CFrame.new(currentPosition) * bulletRotation
                end)
            end
        end
    end
end)

