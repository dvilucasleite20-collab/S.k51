F.setupKiller = function(k)
    if not k:IsA("Model") or trackedKillers[k] then
        return
    end

    local hum = k:FindFirstChildOfClass("Humanoid")
        or k:FindFirstChild("Humanoid", true)

    if not hum then
        task.delay(0.1, function()
            if k.Parent == Killers then
                F.setupKiller(k)
            end
        end)

        return
    end

    if hum.Health <= 0 then
        return
    end

    trackedKillers[k] = {
        last = k:GetPivot().Position,
        moved = false,
        dead = false,
        controllerName = nil,
        nextNameLookup = 0
    }

    hum.Died:Connect(function()
        F.removeHighlight(k)
        F.removeKillerHealthESP(k)

        local d = trackedKillers[k]

        if d then
            d.dead = true
        end
    end)
end

