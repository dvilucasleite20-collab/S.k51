local NoclipPartsBackup = setmetatable({}, {__mode = "k"})
local NoclipTrackedParts = setmetatable({}, {__mode = "k"})
local NoclipCurrentFloor = nil
local NoclipConnection = nil
local NoclipDescendantConnection = nil

local function NoclipTrackPart(obj)
    if not obj or not obj:IsA("BasePart") then
        return
    end

    if NoclipPartsBackup[obj] == nil then
        NoclipPartsBackup[obj] = obj.CanCollide
    end

    NoclipTrackedParts[obj] = true
end

local function NoclipFindFloor(character, rootPart)
    if not rootPart then
        return nil
    end

    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = character and {character} or {}
    params.IgnoreWater = true

    local result = Workspace:Raycast(
        rootPart.Position + Vector3.new(0, 0.5, 0),
        Vector3.new(0, -8, 0),
        params
    )

    if result and result.Instance and result.Instance:IsA("BasePart") then
        return result.Instance
    end

    return nil
end

F.stopNoclip = function()
    if NoclipConnection then
        NoclipConnection:Disconnect()
        NoclipConnection = nil
    end

    if NoclipDescendantConnection then
        NoclipDescendantConnection:Disconnect()
        NoclipDescendantConnection = nil
    end

    for part, originalCanCollide in pairs(NoclipPartsBackup) do
        if part and part.Parent then
            pcall(function()
                part.CanCollide = originalCanCollide
            end)
        end
    end

    F.clearTable(NoclipPartsBackup)
    F.clearTable(NoclipTrackedParts)
    NoclipCurrentFloor = nil
end

F.startNoclip = function()
    F.stopNoclip()

    for _, obj in ipairs(Workspace:GetDescendants()) do
        NoclipTrackPart(obj)
    end

    NoclipDescendantConnection = Workspace.DescendantAdded:Connect(function(obj)
        if Config.Noclip then
            NoclipTrackPart(obj)
        end
    end)

    local noclipAccumulator = 0
    NoclipConnection = RunService.Heartbeat:Connect(function(dt)
        if not Config.Noclip then
            return
        end

        noclipAccumulator += dt
        if noclipAccumulator < 0.10 then
            return
        end
        noclipAccumulator = 0

        local character = LocalPlayer.Character
        local rootPart = character and (character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Torso"))
        local floor = NoclipFindFloor(character, rootPart)
        NoclipCurrentFloor = floor

        for part in pairs(NoclipTrackedParts) do
            if not part or not part.Parent then
                NoclipTrackedParts[part] = nil
                NoclipPartsBackup[part] = nil
                continue
            end

            local wanted = part == floor and NoclipPartsBackup[part] == true or false
            if part.CanCollide ~= wanted then
                part.CanCollide = wanted
            end
        end
    end)
end

