F.backupProperty = function(tbl, key)
    if not tbl or WeaponPropertyBackup[tbl] == nil then
        WeaponPropertyBackup[tbl] = {}
    end

    if WeaponPropertyBackup[tbl][key] == nil then
        WeaponPropertyBackup[tbl][key] = {
            Exists = tbl[key] ~= nil,
            Value = tbl[key]
        }
    end
end

F.setWeaponProperty = function(tbl, key, value)
    F.backupProperty(tbl, key)
    tbl[key] = value
end

F.restoreWeaponProperty = function(tbl, key)
    local backup = WeaponPropertyBackup[tbl]
    local data = backup and backup[key]

    if not data then
        return
    end

    if data.Exists then
        tbl[key] = data.Value
    else
        tbl[key] = nil
    end
end

F.applyWeaponToggles = function()
    if not WeaponModule or not WeaponModule:IsA("ModuleScript") then
        return
    end

    pcall(function()
        local t = require(WeaponModule)
        if typeof(t) ~= "table" then
            return
        end

        if Config.NoBolt then
            F.setWeaponProperty(t, "is_auto", true)
            F.setWeaponProperty(t, "bolt_fire", false)
            F.setWeaponProperty(t, "bolt_cancelled", true)
        else
            F.restoreWeaponProperty(t, "is_auto")
            F.restoreWeaponProperty(t, "bolt_fire")
            F.restoreWeaponProperty(t, "bolt_cancelled")
        end

        if Config.NoSpread then
            F.setWeaponProperty(t, "inaccuracy", 0)
        else
            F.restoreWeaponProperty(t, "inaccuracy")
        end

        local recoilKeys = {"recoil", "recoil_amount", "recoil_speed", "recoil_return"}
        for _, key in ipairs(recoilKeys) do
            if Config.NoRecoil then
                F.setWeaponProperty(t, key, 0)
            else
                F.restoreWeaponProperty(t, key)
            end
        end

    end)
end

local NoShootWaitBackup = setmetatable({}, {__mode = "k"})
local NoShootWaitProcessed = setmetatable({}, {__mode = "k"})

local function ApplyNoShootWaitToModule(desc)
    if not Config.NoShootWait or not desc or not desc:IsA("ModuleScript") then
        return
    end

    if NoShootWaitProcessed[desc] then
        return
    end

    NoShootWaitProcessed[desc] = true

    pcall(function()
        local t = require(desc)
        if typeof(t) ~= "table" or type(t.shoot_wait) ~= "number" then
            return
        end

        if NoShootWaitBackup[t] == nil then
            NoShootWaitBackup[t] = t.shoot_wait
        end

        t.shoot_wait = 0.0001
    end)
end

local function ApplyNoShootWait()
    if not Config.NoShootWait or not WeaponModule then
        return
    end

    for _, desc in ipairs(WeaponModule:GetDescendants()) do
        ApplyNoShootWaitToModule(desc)
    end
end

local function RestoreNoShootWait()
    for t, original in pairs(NoShootWaitBackup) do
        pcall(function()
            t.shoot_wait = original
        end)
    end
    F.clearTable(NoShootWaitBackup)
    F.clearTable(NoShootWaitProcessed)
end

local NoBoltProcessed = setmetatable({}, {__mode = "k"})

local function IsNoBoltAnimationModule(obj)
    if not obj or not obj:IsA("ModuleScript") then
        return false
    end

    local name = string.lower(obj.Name)
    return name == "reload"
        or name == "bolt"
        or (obj.Parent and obj.Parent.Name == "Animations")
end

local function ApplyNoBoltToModule(desc)
    if not Config.NoBolt or not IsNoBoltAnimationModule(desc) then
        return
    end

    if NoBoltProcessed[desc] then
        return
    end

    NoBoltProcessed[desc] = true

    pcall(function()
        local t = require(desc)
        if typeof(t) ~= "table" then
            return
        end

        if not AnimationModuleBackup[t] then
            local original = {}
            for k, v in pairs(t) do
                original[k] = v
            end
            AnimationModuleBackup[t] = original
        end

        for k in pairs(t) do
            t[k] = nil
        end
    end)
end

F.aplicarAnimacoesNoBolt = function()
    if not Config.NoBolt or not WeaponModule then
        return
    end

    for _, desc in ipairs(WeaponModule:GetDescendants()) do
        ApplyNoBoltToModule(desc)
    end
end

F.restaurarAnimacoesNoBolt = function()
    for t, original in pairs(AnimationModuleBackup) do
        pcall(function()
            for k in pairs(t) do
                t[k] = nil
            end
            for k, v in pairs(original) do
                t[k] = v
            end
        end)
    end
    F.clearTable(AnimationModuleBackup)
    F.clearTable(NoBoltProcessed)
end


