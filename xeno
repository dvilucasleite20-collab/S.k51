            connection:Disconnect()
        end
        ExplosionOptimizerAncestryConnections[explosion] = nil
    end

    ExplosionOptimizerVisual = nil
end

local function ProcessExplosionOptimizer(explosion)
    if not Config.OptimizeExplosions or not explosion:IsA("Explosion") then
        return
    end

    if ExplosionOptimizerVisual and ExplosionOptimizerVisual.Parent then
        return
    end

    ExplosionOptimizerVisual = explosion

    ExplosionOptimizerAncestryConnections[explosion] = explosion.AncestryChanged:Connect(function(_, parent)
        if not parent and ExplosionOptimizerVisual == explosion then
            ExplosionOptimizerVisual = nil
        end

        local connection = ExplosionOptimizerAncestryConnections[explosion]
        if connection then
            connection:Disconnect()
            ExplosionOptimizerAncestryConnections[explosion] = nil
        end
    end)
end

local function StartExplosionOptimizer()
    StopExplosionOptimizer()

    Config.OptimizeExplosions = true

    for _, obj in ipairs(Workspace:GetDescendants()) do
        if obj:IsA("Explosion") then
            ProcessExplosionOptimizer(obj)
            if ExplosionOptimizerVisual then
                break
            end
        end
    end

    ExplosionOptimizerConnection = Workspace.DescendantAdded:Connect(function(obj)
        if Config.OptimizeExplosions and obj:IsA("Explosion") then
            ProcessExplosionOptimizer(obj)
        end
    end)
end

