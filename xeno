        rootPart.AssemblyLinearVelocity = Vector3.zero
        rootPart.AssemblyAngularVelocity = Vector3.zero
    end
end

F.startFly = function()
    F.stopFly()

    local function setupCharacter(character)
        if not Config.Fly or not character or not character.Parent then
            return
        end

        if flyConnection then
            flyConnection:Disconnect()
            flyConnection = nil
        end

        if flyOrientation then
            flyOrientation:Destroy()
            flyOrientation = nil
        end

        if flyGravityForce then
            flyGravityForce:Destroy()
            flyGravityForce = nil
        end

        if flyAttachment then
            flyAttachment:Destroy()
            flyAttachment = nil
        end

        local humanoid = FindChildOfClass(character, "Humanoid") or character:WaitForChild("Humanoid", 5)
        local rootPart = FindFirstChild(character, "HumanoidRootPart") or character:WaitForChild("HumanoidRootPart", 5)

        if not humanoid or not rootPart or not Config.Fly then
            return
        end

        humanoid.AutoRotate = false

        flyAttachment = InstanceNew("Attachment")
        flyAttachment.Name = "SaktkFlyAttachment"
        flyAttachment.Parent = rootPart

        flyGravityForce = InstanceNew("VectorForce")
        flyGravityForce.Name = "SaktkFlyGravity"
        flyGravityForce.Attachment0 = flyAttachment
        flyGravityForce.RelativeTo = Enum.ActuatorRelativeTo.World
        flyGravityForce.ApplyAtCenterOfMass = true
        flyGravityForce.Parent = rootPart

        flyOrientation = InstanceNew("AlignOrientation")
        flyOrientation.Name = "SaktkFlyOrientation"
        flyOrientation.Mode = Enum.OrientationAlignmentMode.OneAttachment
        flyOrientation.Attachment0 = flyAttachment
        flyOrientation.MaxTorque = math.huge
        flyOrientation.MaxAngularVelocity = math.huge
        flyOrientation.Responsiveness = 200
        flyOrientation.RigidityEnabled = true
        flyOrientation.Parent = rootPart

        flyConnection = RunService.Heartbeat:Connect(function()
            if not Config.Fly or not character.Parent or humanoid.Health <= 0 or not rootPart.Parent then
                if not Config.Fly then
                    rootPart.AssemblyLinearVelocity = Vector3.zero
                    rootPart.AssemblyAngularVelocity = Vector3.zero
                end
                return
            end

            local camera = Workspace.CurrentCamera
            if not camera then
                return
            end

            flyGravityForce.Force = Vector3.new(0, rootPart.AssemblyMass * Workspace.Gravity, 0)

            local cameraLook = camera.CFrame.LookVector
            local flatLook = Vector3.new(cameraLook.X, 0, cameraLook.Z)
            local flatRight = Vector3.new(camera.CFrame.RightVector.X, 0, camera.CFrame.RightVector.Z)

            if flatLook.Magnitude <= 0.001 then
                local rootLook = rootPart.CFrame.LookVector
                flatLook = Vector3.new(rootLook.X, 0, rootLook.Z)
            end

            if flatRight.Magnitude <= 0.001 then
                flatRight = Vector3.new(1, 0, 0)
            end

            flatLook = flatLook.Unit
            flatRight = flatRight.Unit

            local moveDirection = humanoid.MoveDirection

            if moveDirection.Magnitude > 0.05 then
                local forwardInput = math.clamp(moveDirection:Dot(flatLook), -1, 1)
                local rightInput = math.clamp(moveDirection:Dot(flatRight), -1, 1)

                local flyDirection = flatLook * forwardInput
                    + flatRight * rightInput
                    + Vector3.new(0, cameraLook.Y * forwardInput, 0)

                if flyDirection.Magnitude > 0.001 then
                    rootPart.AssemblyLinearVelocity = flyDirection.Unit * Config.FlySpeed
                else
                    rootPart.AssemblyLinearVelocity = Vector3.zero
                end
            else
                rootPart.AssemblyLinearVelocity = Vector3.zero
            end

            flyOrientation.CFrame = CFrame.lookAt(Vector3.zero, cameraLook)
            rootPart.AssemblyAngularVelocity = Vector3.zero
        end)
    end

    if LocalPlayer.Character then
        setupCharacter(LocalPlayer.Character)
    end

    flyCharacterConnection = LocalPlayer.CharacterAdded:Connect(function(character)
        if Config.Fly then
            task.defer(setupCharacter, character)
        end
    end)
end

