F.GunKillAuraGetRandomKiller = function()
    local validKillers = {}
    local seen = {}

    local killerList = Killers:GetChildren()
    local hasDirectKiller = false

    for _, killer in ipairs(killerList) do
        if killer:IsA("Model") and killer.Name ~= "Jane" then
            hasDirectKiller = true
            break
        end
    end

    if not hasDirectKiller then
        killerList = Killers:GetDescendants()
    end

    for _, killer in ipairs(killerList) do
        if killer:IsA("Model") and not seen[killer] and killer.Name ~= "Jane" then
            local humanoid =
                killer:FindFirstChildOfClass("Humanoid")
                or killer:FindFirstChild("Humanoid", true)

            if humanoid and humanoid.Health > 0 then
                local targetPart =
                    killer:FindFirstChild("Head", true)
                    or killer:FindFirstChild("HumanoidRootPart", true)
                    or killer:FindFirstChild("Torso", true)

                if targetPart and targetPart:IsA("BasePart") then
                    seen[killer] = true
                    table.insert(validKillers, {
                        Model = killer,
                        Part = targetPart
                    })
                end
            end
        end
    end

    if #validKillers == 0 then
        return nil, nil
    end

    local chosen = validKillers[math.random(1, #validKillers)]
    return chosen.Model, chosen.Part
end

F.GunKillAuraGetNearestKiller = function(position)
    local nearestKiller = nil
    local nearestPart = nil
    local nearestDistance = math.huge

    for _, killer in ipairs(Killers:GetChildren()) do
        if killer.Name == "Jane" then
            continue
        end

        if not killer:IsA("Model") then
            continue
        end

        local humanoid =
            killer:FindFirstChildOfClass("Humanoid")
            or killer:FindFirstChild("Humanoid", true)

        if not humanoid or humanoid.Health <= 0 then
            continue
        end

        local targetPart =
            killer:FindFirstChild("Head", true)
            or killer:FindFirstChild("HumanoidRootPart", true)
            or killer:FindFirstChild("Torso", true)

        if not targetPart or not targetPart:IsA("BasePart") then
            continue
        end

        local distance = (targetPart.Position - position).Magnitude
        if distance < nearestDistance then
            nearestDistance = distance
            nearestKiller = killer
            nearestPart = targetPart
        end
    end

    return nearestKiller, nearestPart
end

F.GunKillAuraIsMyBullet = function(bullet)
    if not Config.GunKillAura then
