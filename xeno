--============================================================
-- FREECAM
-- Otimizado para mobile: uma conexao de render e toque apenas
-- enquanto o modo estiver ativo. No mobile, arrastar o dedo
-- gira a camera; o direcional do personagem move a camera.
--============================================================

local FreecamConnection = nil
local FreecamInputBegan = nil
local FreecamInputChanged = nil
local FreecamInputEnded = nil
local FreecamTouch = nil
local FreecamYaw = 0
local FreecamPitch = 0
local FreecamPosition = nil
local FreecamSpeed = 35
local FreecamCameraTypeBackup = nil
local FreecamCameraSubjectBackup = nil

F.stopFreecam = function()
    if FreecamConnection then FreecamConnection:Disconnect(); FreecamConnection = nil end
    if FreecamInputBegan then FreecamInputBegan:Disconnect(); FreecamInputBegan = nil end
    if FreecamInputChanged then FreecamInputChanged:Disconnect(); FreecamInputChanged = nil end
    if FreecamInputEnded then FreecamInputEnded:Disconnect(); FreecamInputEnded = nil end

    FreecamTouch = nil

    local camera = Workspace.CurrentCamera
    if camera then
        if FreecamCameraTypeBackup then
            camera.CameraType = FreecamCameraTypeBackup
        else
            camera.CameraType = Enum.CameraType.Custom
        end
        if FreecamCameraSubjectBackup then
            camera.CameraSubject = FreecamCameraSubjectBackup
        end
    end

    FreecamCameraTypeBackup = nil
    FreecamCameraSubjectBackup = nil
    FreecamPosition = nil
end

F.startFreecam = function()
    F.stopFreecam()

    local camera = Workspace.CurrentCamera
    if not camera then return end

    FreecamCameraTypeBackup = camera.CameraType
    FreecamCameraSubjectBackup = camera.CameraSubject
    FreecamPosition = camera.CFrame.Position
    local look = camera.CFrame.LookVector
    FreecamYaw = math.atan2(-look.X, -look.Z)
    FreecamPitch = math.asin(math.clamp(look.Y, -1, 1))
    camera.CameraType = Enum.CameraType.Scriptable

    FreecamInputBegan = UserInputService.InputBegan:Connect(function(input, processed)
        if processed or not Config.Freecam then return end
        if input.UserInputType == Enum.UserInputType.Touch then
            FreecamTouch = {Position = input.Position, Id = input}
        end
    end)

    FreecamInputChanged = UserInputService.InputChanged:Connect(function(input, processed)
        if processed or not Config.Freecam then return end
        if input.UserInputType == Enum.UserInputType.Touch and FreecamTouch and input == FreecamTouch.Id then
            local delta = input.Delta
            FreecamYaw -= delta.X * 0.003
            FreecamPitch = math.clamp(FreecamPitch - delta.Y * 0.003, -1.45, 1.45)
        elseif input.UserInputType == Enum.UserInputType.MouseMovement then
            FreecamYaw -= input.Delta.X * 0.0025
            FreecamPitch = math.clamp(FreecamPitch - input.Delta.Y * 0.0025, -1.45, 1.45)
        end
    end)

    FreecamInputEnded = UserInputService.InputEnded:Connect(function(input)
        if FreecamTouch and input == FreecamTouch.Id then
            FreecamTouch = nil
        end
    end)

    FreecamConnection = RunService.RenderStepped:Connect(function(dt)
        if not Config.Freecam then return end

        local currentCamera = Workspace.CurrentCamera
        if not currentCamera then return end

        local character = LocalPlayer.Character
        local humanoid = character and FindChildOfClass(character, "Humanoid")
        local move = humanoid and humanoid.MoveDirection or Vector3.zero

        local rotation = CFrame.Angles(0, FreecamYaw, 0) * CFrame.Angles(FreecamPitch, 0, 0)
        local forwardRaw = rotation.LookVector
        local forward = Vector3.new(forwardRaw.X, 0, forwardRaw.Z)
        local rightRaw = rotation.RightVector
        local right = Vector3.new(rightRaw.X, 0, rightRaw.Z)
        if forward.Magnitude > 0 then forward = forward.Unit end
        if right.Magnitude > 0 then right = right.Unit end
        local moveVector = Vector3.new(move.X, 0, move.Z)

        if moveVector.Magnitude > 0 then
            moveVector = moveVector.Unit
            FreecamPosition += (right * moveVector.X + forward * moveVector.Z) * FreecamSpeed * dt
        end

        currentCamera.CFrame = CFrame.new(FreecamPosition) * rotation
    end)
end

--============================================================
-- TELEPORT TO CURSOR
-- Clique/toque curto teleporta para o ponto atingido.
-- No mobile, arrastar ou manter o dedo pressionado nao ativa.
--============================================================

local TeleportToCursorConnections = {}
local TeleportToCursorTouchStart = nil
local TeleportToCursorTouchTime = 0
local TeleportToCursorMaxHold = 0.35
local TeleportToCursorMaxMove = 12

local function TeleportToCursorIsGuiPosition(position)
    local ok, objects = pcall(function()
        return GuiService:GetGuiObjectsAtPosition(position.X, position.Y)
    end)

    if not ok or not objects then
        return false
    end

    return #objects > 0
end

local function TeleportToCursorAtPosition(position)
    if not Config.TeleportToCursor then
        return
    end

    if TeleportToCursorIsGuiPosition(position) then
        return
    end

    local character = LocalPlayer.Character
    local rootPart = character and (character:FindFirstChild("HumanoidRootPart") or character:FindFirstChild("Torso"))
    local camera = Workspace.CurrentCamera

    if not character or not rootPart or not camera then
        return
    end

    local viewport = camera.ViewportSize
    if position.X < 0 or position.Y < 0 or position.X > viewport.X or position.Y > viewport.Y then
        return
    end

    local ray = camera:ViewportPointToRay(position.X, position.Y)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    params.FilterDescendantsInstances = {character}
    params.IgnoreWater = true

    local result = Workspace:Raycast(ray.Origin, ray.Direction * 1000, params)
    if not result then
        return
    end

    local targetPosition = result.Position + result.Normal * 2
    local currentLook = rootPart.CFrame.LookVector
    local lookPosition = targetPosition + Vector3.new(currentLook.X, 0, currentLook.Z)

    pcall(function()
        character:PivotTo(CFrame.lookAt(targetPosition, lookPosition))
    end)
end

F.stopTeleportToCursor = function()
    for _, connection in pairs(TeleportToCursorConnections) do
        if connection then
            connection:Disconnect()
        end
    end

    F.clearTable(TeleportToCursorConnections)
    TeleportToCursorTouchStart = nil
    TeleportToCursorTouchTime = 0
end

F.startTeleportToCursor = function()
    F.stopTeleportToCursor()

    TeleportToCursorConnections.InputBegan = UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if not Config.TeleportToCursor or gameProcessed then
            return
        end

        if input.UserInputType == Enum.UserInputType.MouseButton1 then
            TeleportToCursorAtPosition(input.Position)
            return
        end

        if input.UserInputType == Enum.UserInputType.Touch then
            if TeleportToCursorIsGuiPosition(input.Position) then
                return
            end

            TeleportToCursorTouchStart = input.Position
            TeleportToCursorTouchTime = os.clock()
        end
    end)

    TeleportToCursorConnections.InputEnded = UserInputService.InputEnded:Connect(function(input)
        if not Config.TeleportToCursor or input.UserInputType ~= Enum.UserInputType.Touch then
            return
        end

        local startPosition = TeleportToCursorTouchStart
        local startTime = TeleportToCursorTouchTime
        TeleportToCursorTouchStart = nil
        TeleportToCursorTouchTime = 0

        if not startPosition or startTime <= 0 then
            return
        end

        local duration = os.clock() - startTime
        local distance = (input.Position - startPosition).Magnitude

        if duration <= TeleportToCursorMaxHold and distance <= TeleportToCursorMaxMove then
            TeleportToCursorAtPosition(input.Position)
        end
    end)
end

