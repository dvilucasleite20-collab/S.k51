-- Auto Equip Single Tool
-- Ignora Energy, Landmine, HookShot e Freeze/FreezerGun (case-insensitive).
-- Usa um loop leve para continuar funcionando mesmo se Backpack/Tool aparecer depois.
local function AutoEquipSingleToolTick()
    if not Config.AutoEquipSingleTool then
        return
    end

    local character = LocalPlayer.Character
    local humanoid = character and character:FindFirstChildOfClass("Humanoid")
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    if not humanoid or humanoid.Health <= 0 or not backpack then
        return
    end

    local validTool = nil
    local validCount = 0

    for _, tool in ipairs(backpack:GetChildren()) do
        if tool:IsA("Tool") then
            local name = string.lower((tool.Name or ""):gsub("%s+", ""))
            local excluded = name == "energy"
                or name == "landmine"
                or name == "hookshot"
                or name == "freezegun"
                or name == "freezergun"

            if not excluded then
                validCount = validCount + 1
                validTool = tool
                if validCount > 1 then
                    return
                end
            end
        end
    end

    if validCount == 1 and validTool and validTool.Parent == backpack then
        pcall(function()
            humanoid:EquipTool(validTool)
        end)
    end
end

