local AutoPickMaterialParts = setmetatable({}, {__mode = "k"})
local AutoPickMaterialConnection = nil
local AutoPickMaterialDescendantConnection = nil

local function IsAutoPickMaterialPart(obj)
    if not Config.AutoPickMaterial or not obj:IsA("BasePart") or obj.Parent ~= Workspace then
        return false
    end

    local children = obj:GetChildren()
    local childCount = #children

    -- Obrigatorios: TouchInterest + Fire. SpecialMesh e opcional.
    if childCount ~= 2 and childCount ~= 3 then
        return false
    end

    local hasTouchInterest = false
    local hasFire = false
    local hasSpecialMesh = false

    for i = 1, childCount do
        local child = children[i]

        if child.Name == "TouchInterest" and child:IsA("TouchTransmitter") then
            hasTouchInterest = true
        elseif child.Name == "Fire" and child:IsA("Fire") then
            hasFire = true
        elseif child:IsA("SpecialMesh") then
            hasSpecialMesh = true
        else
            return false
        end
    end

    return hasTouchInterest and hasFire
end

local function TrackAutoPickMaterialPart(part)
    if IsAutoPickMaterialPart(part) then
        AutoPickMaterialParts[part] = true
    else
        AutoPickMaterialParts[part] = nil
    end
end

local function StopAutoPickMaterial()
    if AutoPickMaterialConnection then
        AutoPickMaterialConnection:Disconnect()
        AutoPickMaterialConnection = nil
    end

    if AutoPickMaterialDescendantConnection then
        AutoPickMaterialDescendantConnection:Disconnect()
        AutoPickMaterialDescendantConnection = nil
    end

    F.clearTable(AutoPickMaterialParts)
end

local function StartAutoPickMaterial()
    StopAutoPickMaterial()

    for _, obj in ipairs(Workspace:GetChildren()) do
        TrackAutoPickMaterialPart(obj)
    end

    AutoPickMaterialDescendantConnection = Workspace.DescendantAdded:Connect(function(obj)
        if not Config.AutoPickMaterial then
            return
        end

        local part = obj
        if not part:IsA("BasePart") then
            part = obj.Parent
        end

        if part and part:IsA("BasePart") and part.Parent == Workspace then
            task.defer(TrackAutoPickMaterialPart, part)
        end
    end)

    AutoPickMaterialConnection = RunService.Heartbeat:Connect(function()
        if not Config.AutoPickMaterial then
            return
        end

        local character = LocalPlayer.Character
        local root = character and (FindFirstChild(character, "HumanoidRootPart") or FindFirstChild(character, "Torso"))

        if not root then
            return
        end

        for part in pairs(AutoPickMaterialParts) do
            if part.Parent ~= Workspace then
                AutoPickMaterialParts[part] = nil
            else
                part.CFrame = root.CFrame
            end
        end
    end)
end


