F.GunKillAuraGetKillhouseTarget = function(position)
    if game.PlaceId ~= 4631179692 then
        return nil, nil, nil
    end

    local area51 = Workspace:FindFirstChild("AREA51")
    local killhouse = area51 and area51:FindFirstChild("Killhouse")
    local targetsFolder = killhouse and killhouse:FindFirstChild("Targets")

    if not targetsFolder then
        return nil, nil, nil
    end

    local bestTarget = nil
    local bestMiddle = nil
    local bestDistance = math.huge

    for index = 1, 14 do
        local partFolder = targetsFolder:FindFirstChild("Part" .. index)
        if partFolder then
            for _, obj in ipairs(partFolder:GetDescendants()) do
                if obj.Name == "Target" then
                    local enemy = obj:FindFirstChild("Enemy", true)
                    local middle = obj:FindFirstChild("Middle", true)

                    if enemy
                        and enemy:IsA("Humanoid")
                        and enemy.Health == 100
                        and middle
                        and middle:IsA("BasePart") then

                        local distance = position
                            and (middle.Position - position).Magnitude
                            or 0

                        if not bestTarget or distance < bestDistance then
                            bestTarget = obj
                            bestMiddle = middle
                            bestDistance = distance
                        end
                    end
                end
            end
        end
    end

    return bestTarget, bestMiddle, "Killhouse"
end

local function GunKillAuraSetAberrationBlockerDeleted(deleted)
    if deleted then
        local area51 = Workspace:FindFirstChild("AREA51")
        local map = area51 and area51:FindFirstChild("Map")
        local pool = map and map:FindFirstChild("Pool")
        local blocker = pool and pool:FindFirstChild("Blocker")

        if blocker and blocker:IsA("BasePart") then
            gunKillAuraAberrationBlocker = blocker
            gunKillAuraAberrationBlockerParent = blocker.Parent
            gunKillAuraAberrationBlockerCFrame = blocker.CFrame
            blocker.Parent = nil
            gunKillAuraAberrationBlockerDeleted = true
        elseif gunKillAuraAberrationBlocker and not gunKillAuraAberrationBlocker.Parent then
            gunKillAuraAberrationBlockerDeleted = true
        end
    else
        local blocker = gunKillAuraAberrationBlocker
        if blocker and not blocker.Parent and gunKillAuraAberrationBlockerParent then
            blocker.Parent = gunKillAuraAberrationBlockerParent
            if gunKillAuraAberrationBlockerCFrame then
                blocker.CFrame = gunKillAuraAberrationBlockerCFrame
            end
        end
        gunKillAuraAberrationBlockerDeleted = false
    end
end

